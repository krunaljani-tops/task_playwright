{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CatalogData",
  "type": "object",
  "required": ["categories", "products"],
  "properties": {
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "slug"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "slug": { "type": "string" }
        }
      }
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "slug", "price", "images"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "slug": { "type": "string" },
          "price": { "type": "string" },
          "images": { "type": "array" }
        }
      }
    }
  }
}

