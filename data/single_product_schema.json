{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Product",
  "type": "object",
  "required": ["id", "name", "slug", "price", "images"],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "price": {
      "type": "string"
    },
    "compareAtPrice": {
      "type": ["string", "null"]
    },
    "stockQuantity": {
      "type": "integer"
    },
    "sku": {
      "type": "string"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "categoryId": {
      "type": "string"
    },
    "isActive": {
      "type": "boolean"
    },
    "createdAt": {
      "type": "string"
    },
    "category": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" }
      }
    }
  }
}

